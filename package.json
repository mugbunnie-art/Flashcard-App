{
  "name": "flashcard-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "lint": "eslint .",
    "test": "npm run test -w server && npm run test -w client",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx}": "eslint"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6"
  }
}
